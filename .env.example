# Base URL of the deployed app, used by NextAuth for redirects and callbacks
NEXTAUTH_URL=
# Secret used by NextAuth to sign/encrypt session tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Google OAuth client ID used for Gmail API access
GOOGLE_CLIENT_ID=
# Google OAuth client secret used for Gmail API access
GOOGLE_CLIENT_SECRET=
# OpenAI API key used for AI-powered features
OPENAI_API_KEY=
# Upstash Redis REST URL used for rate limiting and caching
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token used to authenticate Redis requests
UPSTASH_REDIS_REST_TOKEN=
# Resend API key used to send transactional email
RESEND_API_KEY=
# Verified sender address used as the From header on outgoing email
RESEND_FROM_EMAIL=
# Shared secret required by the /api/cron/poll endpoint
CRON_SECRET=
# Display name of the hiring company shown across the app
COMPANY_NAME=
